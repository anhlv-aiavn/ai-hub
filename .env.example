# Sao chép thành .env rồi chỉnh. Compose tự nạp .env cùng thư mục.

# ── Model VLM ───────────────────────────────────────────────────────────────
VLLM_BASE_URL=http://192.168.120.9:30000/v1
# Nhiều máy vLLM (chia việc + failover): danh sách ngăn cách dấu phẩy, mỗi mục
# "url" hoặc "url|model|key" (máy khác model/key mới cần phần sau). Bỏ trống →
# chỉ dùng VLLM_BASE_URL. Thêm máy vào đây là năng lực tự nhân lên, không sửa code.
VLLM_ENDPOINTS=http://192.168.120.9:30000/v1,http://192.168.120.10:30001/v1
VLLM_MODEL_NAME=gemma-4-26B-A4B-NVFP4
VLLM_API_KEY=EMPTY
ENABLE_THINKING=false

# ── MinIO (đã có sẵn — kho dùng chung) ──────────────────────────────────────
ENDPOINT_URL_MINIO=https://storage.ai-hub.tumiki.org
AWS_ACCESS_KEY_ID_MINIO=minioadmin
AWS_SECRET_ACCESS_KEY_MINIO=Tumiki2026
AIHUB_BUCKET=ai-hub
# Client MinIO POOL sống lâu (PERF-1): tái dùng 1 client/endpoint thay vì tạo mới
# mỗi call (mỗi call cũ = 1 bắt tay TCP/TLS → nghẽn ingest). Mặc định BẬT.
# KILL-SWITCH: đặt false để quay lại hành vi cũ NGAY (khi nghi pool gây sự cố).
AIHUB_S3_POOL=true
# Trần connection trong pool — nên ≥ số S3-op đồng thời (~MAX_IN_FLIGHT + cut).
AIHUB_S3_POOL_MAX_CONNECTIONS=128

# ── API key cũ (tùy chọn, sắp bỏ). Để trống. Auth giờ dùng tài khoản bên dưới.
AIHUB_API_KEY=

# ── Tài khoản & RBAC ────────────────────────────────────────────────────────
# BẮT BUỘC đặt secret ngẫu nhiên dài (vd: openssl rand -hex 32) cho môi trường thật.
AIHUB_JWT_SECRET=8f893011f10f92b9110b2580af6a26d60c4ac987562b596c707052aa89ca4a49
AIHUB_JWT_TTL_SECONDS=604800
# Admin đầu tiên — tự tạo lúc khởi động nếu chưa có. Đăng nhập xong nên đổi mật khẩu.
AIHUB_ADMIN_USER=admin
AIHUB_ADMIN_PASS=admin
# Chống brute-force: sai quá N lần → khóa tạm (giây).
AIHUB_LOGIN_MAX_FAILS=5
AIHUB_LOGIN_LOCK_SECONDS=300
# 1 tài khoản chỉ 1 phiên đăng nhập (chặn login nơi khác khi phiên cũ còn hoạt
# động). Mặc định false = cho phép nhiều phiên song song.
AIHUB_SINGLE_SESSION_ENABLED=false

# ── Tải xử lý / tận dụng GPU ─────────────────────────────────────────────────
# MAX_VLM_CONCURRENT = trần call đồng thời MỖI máy vLLM. Tổng năng lực = giá trị
# này × số endpoint trong VLLM_ENDPOINTS. Số càng cao càng bơm đầy GPU nhưng ngốn
# VRAM (KV-cache) + RAM; nới rồi phải bench + xem nvidia-smi để chắc GPU không OOM.
MAX_VLM_CONCURRENT=64
# MAX_IN_FLIGHT = số hồ sơ xử lý song song (bound RAM ảnh render). Nên ≥ trần tổng
# để luôn có đủ request nuôi mọi GPU. Cao → worker cần nhiều RAM.
MAX_IN_FLIGHT=128
# Circuit-breaker: máy vLLM vừa lỗi kết nối bị "làm nguội" N giây → bộ chọn tải
# né nó, khỏi phí một lần thử-máy-chết mỗi request khi 1 máy tắt. 0 = tắt tính
# năng. Nếu mọi máy đều đang nguội thì vẫn probe 1 máy (không bỏ cuộc).
VLM_ENDPOINT_COOLDOWN_SECONDS=15
# Tách file PDF per-GCN (cut-*.pdf) ghi lên S3 đích. false = KHÔNG tạo file cắt →
# bỏ tải ghi hàng loạt lên đích (tránh 502 khi đích là cổng public). Dữ liệu trích
# xuất không phụ thuộc cut; tắt chỉ mất file PDF tách + cột "tệp cắt".
AIHUB_BUILD_CUTS=false

# ── Quan sát / đo hiệu năng ─────────────────────────────────────────────────
# Đo thời gian TỪNG CHẶNG mỗi hồ sơ (download / render / detect / extract / cuts)
# ghi vào gcn.timings để `app.scripts.watch --timings` bóc tách nút thắt. Chi phí
# tốc độ ~0; mặc định BẬT. Đặt false nếu muốn doc gọn (bỏ field timings).
AIHUB_TRACE_TIMINGS=true

# ── Pipeline xử lý (tùy chọn — đã có default trong compose) ──────────────────
# KHÔNG giảm DPI/kích thước render — output sẽ không dùng được.
# AIHUB_RENDER_DPI=200
# AIHUB_RENDER_MAX_SIZE=2000
# AIHUB_RENDER_ORIENT=true
# DETECT_VERIFY=true
# EXTRACT_TIMEOUT_SECONDS=3000
# EXTRACT_RETRY_THINKING=false
# AIHUB_MAX_PAGES=250

# Ngưỡng "file ngắn thì khỏi gọi VLM phân loại trang", theo LOẠI GIẤY. gcn giữ
# đúng biến cũ. Biểu mẫu (ddk/kqdk/pcctt): 18/30 phiếu mẫu chỉ có ĐÚNG 1 trang —
# với chúng phân loại là phí hoàn toàn vì không có gì để lọc.
# DETECT_MIN_PAGES=5
# DETECT_MIN_PAGES_HO_SO=1

# ── Sampling nhánh biểu mẫu (ddk/kqdk/pcctt), KHÔNG áp cho GCN ───────────────
# Mặc định để y như trước khi có mấy biến này: tất định, không phạt lặp, không trần.
# BIEU_MAU_MAX_TOKENS là cái chặn treo chứ không phải cái chỉnh chất lượng —
# đặt trước, rồi mới dò hai cái kia.
BIEU_MAU_TEMPERATURE=0
BIEU_MAU_REPETITION_PENALTY=1.0
BIEU_MAU_MAX_TOKENS=0
